# Gemini
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Supabase — public (safe for browser; publishable/anon only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy alias (optional if publishable key is set):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-or-secret-key
# Optional alias used by older docs / local scripts:
# SUPABASE_URL=https://your-project.supabase.co

# Bootstrap first admin (invite only — never put a password here)
ADMIN_EMAIL=you@example.com

# Optional canonical site URL for invite redirects
# NEXT_PUBLIC_SITE_URL=https://rag-doc-chatbot-brown.vercel.app
